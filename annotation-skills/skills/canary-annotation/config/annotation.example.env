
: "${PROJECT_ROOT:?Set PROJECT_ROOT to an absolute run directory outside the skill}"
RESULTS_ROOT=${PROJECT_ROOT}/results
PIPELINE_DIR=${SKILL_ROOT}/scripts

# raw: item/turns case, detailed.json, or prepared directory; normalized: existing cases.
INPUT_FORMAT=${INPUT_FORMAT:-normalized}
RAW_INPUT=${RAW_INPUT:-}

: "${MODEL_ID:?Set MODEL_ID to a model supported by your API provider}"
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY_ENV=OPENAI_API_KEY

MAX_TOKENS=4096
PRIMARY_MAX_TOKENS=1600
TIMEOUT=300
RETRIES=3
SLEEP_SECONDS=3

NORMALIZED_ROOT=${RESULTS_ROOT}/canary
NORMALIZED_CASES=${NORMALIZED_ROOT}/cases

TARGET_ROOT=${RESULTS_ROOT}/canary_primary_target_full
PRIMARY_UNSAFE_ROOT=${RESULTS_ROOT}/canary_primary_root_unsafe_action
PRIMARY_REFUSAL_ROOT=${RESULTS_ROOT}/canary_primary_root_safety_refusal
ATTACK_CHAIN_ROOT=${RESULTS_ROOT}/canary_attackchain_full
EXECUTION_CHAIN_ROOT=${RESULTS_ROOT}/canary_executionchain_full

UNSAFE_MERGED_ROOT=${RESULTS_ROOT}/canary_full_annotations_unsafe_action
UNSAFE_VALIDATION_ROOT=${RESULTS_ROOT}/canary_full_annotations_unsafe_action_validation
UNSAFE_DETERMINISTIC_ROOT=${UNSAFE_VALIDATION_ROOT}/deterministic_v3
UNSAFE_SEMANTIC_ROOT=${UNSAFE_VALIDATION_ROOT}/semantic

UNSAFE_REPAIR_ROOT=${RESULTS_ROOT}/canary_unsafe_action_repair_cases
UNSAFE_REANNOTATION_ROOT=${RESULTS_ROOT}/canary_unsafe_action_reannotation
UNSAFE_FINAL_ROOT=${RESULTS_ROOT}/canary_full_annotations_unsafe_action_final
UNSAFE_FINAL_VALIDATION_ROOT=${UNSAFE_FINAL_ROOT}_validation
UNSAFE_FINAL_DETERMINISTIC_ROOT=${UNSAFE_FINAL_VALIDATION_ROOT}/deterministic
UNSAFE_FINAL_SEMANTIC_ROOT=${UNSAFE_FINAL_VALIDATION_ROOT}/semantic

SAFETY_REFUSAL_MERGED_ROOT=${RESULTS_ROOT}/canary_safety_refusal_target_primary_annotations
SAFETY_REFUSAL_VALIDATION_ROOT=${RESULTS_ROOT}/canary_safety_refusal_target_primary_annotations_validation/deterministic
SAFETY_REFUSAL_FINAL_ROOT=${RESULTS_ROOT}/canary_safety_refusal_target_primary_annotations_final
SAFETY_REFUSAL_FINAL_VALIDATION_ROOT=${SAFETY_REFUSAL_FINAL_ROOT}_validation/deterministic

EXPECTED_UNSAFE_PASS=
EXPECTED_UNSAFE_REPAIRED=
EXPECTED_UNSAFE_FINAL=

EXPECTED_SAFETY_REFUSAL_BASE=
EXPECTED_SAFETY_REFUSAL_FINAL=
